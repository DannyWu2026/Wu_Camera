<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="120dp" />

    <View
        android:id="@+id/shutter_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="120dp"
        android:alpha="0"
        android:background="#000000"
        android:importantForAccessibility="no" />

    <View
        android:id="@+id/focus_indicator"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/focus_background"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <TextView
        android:id="@+id/flash"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="@drawable/control_background"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/flash_off"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/zoom"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="136dp"
        android:background="@drawable/control_background"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

    <Button
        android:id="@+id/retry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/camera_error_retry"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_gravity="bottom"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center">
            <ImageButton
                android:id="@+id/thumbnail"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:background="@drawable/thumbnail_background"
                android:clipToOutline="true"
                android:contentDescription="@string/no_photo"
                android:enabled="false"
                android:padding="0dp"
                android:scaleType="centerCrop" />
        </FrameLayout>

        <Button
            android:id="@+id/capture"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/shutter_background"
            android:contentDescription="@string/capture"
            android:enabled="false"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center">
            <ImageButton
                android:id="@+id/switch_camera"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:background="@drawable/switch_camera_background"
                android:contentDescription="@string/switch_camera"
                android:enabled="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:src="@drawable/ic_switch_camera" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
